# Определяем путь к рабочему столу и названия файлов
$desktopPath = [Environment]::GetFolderPath("Desktop")
$jsFilesOutput = Join-Path $desktopPath "все js файлы.txt"
$jsContentOutput = Join-Path $desktopPath "контент всего js.txt"

Write-Host "🔄 Начинаем анализ проекта..."

# Удаляем предыдущие файлы если существуют
if (Test-Path $jsFilesOutput) { Remove-Item $jsFilesOutput }
if (Test-Path $jsContentOutput) { Remove-Item $jsContentOutput }

# Функция для безопасного чтения файлов
function Read-FileContent {
    param($FilePath)
    try {
        $content = Get-Content $FilePath -Raw -Encoding UTF8
        return $content
    }
    catch {
        try {
            $content = Get-Content $FilePath -Raw -Encoding Default
            return $content
        }
        catch {
            return "[ОШИБКА ЧТЕНИЯ ФАЙЛА: $($_.Exception.Message)]"
        }
    }
}

# Ищем JS/JSX файлы в папке client/src (полностью рекурсивно)
$clientFiles = @()
if (Test-Path "client\src") {
    $clientFiles = Get-ChildItem "client\src" -Recurse -File -Include '*.js','*.jsx' -ErrorAction SilentlyContinue
    Write-Host "📁 Папка 'client\src': $($clientFiles.Count) файлов"
}

# Ищем JS файлы в папке server (полностью рекурсивно)
$serverFiles = @()
if (Test-Path "server") {
    $serverFiles = Get-ChildItem "server" -Recurse -File -Include '*.js' -ErrorAction SilentlyContinue
    Write-Host "📁 Папка 'server': $($serverFiles.Count) файлов"
}

# Ищем server.js в корне проекта
$rootServerFile = Get-Item "server.js" -ErrorAction SilentlyContinue
if ($rootServerFile) {
    Write-Host "📄 Корневой файл: server.js"
}

# Объединяем все файлы
$jsFiles = @()
$jsFiles += $clientFiles
$jsFiles += $serverFiles
if ($rootServerFile) {
    $jsFiles += $rootServerFile
}

Write-Host "📁 Всего найдено JS/JSX файлов: $($jsFiles.Count)"

# 1) ФАЙЛ С ПЕРЕЧНЕМ ВСЕХ JS/JSX ФАЙЛОВ
"ПЕРЕЧЕНЬ ВСЕХ JS/JSX ФАЙЛОВ ПРОЕКТА" | Out-File $jsFilesOutput -Encoding UTF8
"Дата: $(Get-Date -Format 'dd/MM/yyyy HH:mm:ss')" | Out-File $jsFilesOutput -Encoding UTF8 -Append
"Всего файлов: $($jsFiles.Count)" | Out-File $jsFilesOutput -Encoding UTF8 -Append
"=" * 80 | Out-File $jsFilesOutput -Encoding UTF8 -Append

$jsFiles | Sort-Object FullName | ForEach-Object {
    "$($_.FullName) ($($_.Length) байт)" | Out-File $jsFilesOutput -Encoding UTF8 -Append
}

# 2) ФАЙЛ С СОДЕРЖИМЫМ ВСЕХ JS/JSX ФАЙЛОВ
"ПОЛНОЕ СОДЕРЖИМОЕ ВСЕХ JS/JSX ФАЙЛОВ" | Out-File $jsContentOutput -Encoding UTF8
"Дата: $(Get-Date -Format 'dd/MM/yyyy HH:mm:ss')" | Out-File $jsContentOutput -Encoding UTF8 -Append
"Всего файлов: $($jsFiles.Count)" | Out-File $jsContentOutput -Encoding UTF8 -Append
"=" * 80 | Out-File $jsContentOutput -Encoding UTF8 -Append

$jsFiles | Sort-Object FullName | ForEach-Object {
    "`n" + "=" * 60 | Out-File $jsContentOutput -Encoding UTF8 -Append
    "ФАЙЛ: $($_.FullName)" | Out-File $jsContentOutput -Encoding UTF8 -Append
    "РАЗМЕР: $($_.Length) байт" | Out-File $jsContentOutput -Encoding UTF8 -Append
    "-" * 40 | Out-File $jsContentOutput -Encoding UTF8 -Append
    $content = Read-FileContent -FilePath $_.FullName
    $content | Out-File $jsContentOutput -Encoding UTF8 -Append
}

Write-Host "✅ Анализ завершен! Созданы файлы на рабочем столе:"
Write-Host "   📄 все js файлы.txt - перечень всех JS/JSX файлов"
Write-Host "   📄 контент всего js.txt - содержимое всех JS/JSX файлов"
Write-Host "`n📁 Путь: $desktopPath"