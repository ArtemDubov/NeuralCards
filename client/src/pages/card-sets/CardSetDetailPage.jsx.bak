// Добавляем hover эффект для dropdown через CSS-in-JS хак
const styleElement = document.createElement("style");
styleElement.textContent = `
  .dropdown:hover .dropdown-content {
    display: block;
  }
  
  /* Стили для переключателя видов */
  .view-mode-toggle {
    display: flex;
    gap: 8px;
    margin-bottom: 16px;
  }
  
  .view-mode-button {
    width: 40px;
    height: 40px;
    border: none;
    border-radius: 8px;
    cursor: pointer;
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 16px;
    transition: all 0.2s;
  }
  
  /* Стили для grid-режима */
  .cards-grid {
    max-width: 1200px;
    margin: 0 auto;
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(300px, 1fr));
    gap: 16px;
  }
  
  .card-grid-item {
    padding: 16px;
    border-radius: 12px;
    display: flex;
    flex-direction: column;
    gap: 12px;
    transition: transform 0.2s, box-shadow 0.2s;
  }
  
  .card-grid-item:hover {
    transform: translateY(-2px);
  }
  
  .card-media-preview {
    max-width: 100%;
    border-radius: 6px;
    margin-top: 8px;
  }
  
  .card-grid-actions {
    display: flex;
    gap: 8px;
    justify-content: flex-end;
    margin-top: auto;
  }
`;
document.head.appendChild(styleElement);
