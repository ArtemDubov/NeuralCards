// Добавляем hover эффект для dropdown через CSS-in-JS хак
const styleElement = document.createElement("style");
styleElement.textContent = `
  .dropdown:hover .dropdown-content {
    display: block;
  }
  
  /* Стили для переключателя видов */
  .view-mode-toggle {
    display: flex;
    gap: 8px;
    margin-bottom: 16px;
  }
  
  .view-mode-button {
    width: 40px;
    height: 40px;
    border: none;
    border-radius: 8px;
    cursor: pointer;
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 16px;
    transition: all 0.2s;
  }
  
  /* Стили для grid-режима */
  .cards-grid {
    max-width: 1200px;
    margin: 0 auto;
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(280px, 1fr));
    gap: 14px;
  }

  .compact-media-item {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    padding: 4px 10px;
    background: var(--nt-background-secondary, #f5f5f5);
    border: 1px solid var(--nt-border, #e0e0e0);
    border-radius: 6px;
    font-size: 12px;
  }

  /* Inline insert zone — без зелёных полосок */
  .insert-zone {
    position: relative;
    min-height: 32px;
  }

  /* Card hover effect */
  .nt-detail-card:hover {
    transform: translateY(-1px);
    box-shadow: 0 4px 16px var(--nt-card-shadow, rgba(0,0,0,0.1));
  }
`;
document.head.appendChild(styleElement);
