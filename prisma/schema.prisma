generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "linux-musl-openssl-3.0.x", "debian-openssl-3.0.x"]
}

datasource db {
  provider = "sqlite"
  url      = "file:./dev.db"
}

model User {
  id           Int       @id @default(autoincrement())
  email        String    @unique
  password     String
  name         String?
  avatarEmoji  String?
  avatarColor  String?   @default("transparent")
  avatarUrl    String?
  isPremium    Boolean   @default(false)
  premiumUntil DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  cardSets     CardSet[]
  progress     CardProgress[]
  sessions     StudySession[]
  favoriteCardSets FavoriteCardSet[]
  favoriteCards     FavoriteCard[]
}

model CardSet {
  id          Int       @id @default(autoincrement())
  title       String
  description String?
  isPublic    Boolean   @default(false)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  authorId    Int
  author      User      @relation(fields: [authorId], references: [id], onDelete: Cascade)
  cards       FlashCard[]
  tags        Tag[]     @relation("CardSetToTag")
  search_vector Unsupported("tsvector")?
  sessions    StudySession[]
  favoriteCardSets FavoriteCardSet[]
  
  @@map("card_set")  // Таблица в БД будет card_set
}

model Tag {
  id        Int       @id @default(autoincrement())
  name      String    @unique
  cardSets  CardSet[] @relation("CardSetToTag")
}

model FlashCard {
  id          Int      @id @default(autoincrement())
  front       String
  back        String
  imageUrl    String?
  audioUrl    String?
  backImageUrl String?
  backAudioUrl String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  cardSetId   Int
  cardSet     CardSet  @relation(fields: [cardSetId], references: [id], onDelete: Cascade)
  search_vector Unsupported("tsvector")?
  progress    CardProgress[]
  favoriteCards FavoriteCard[]
  
  @@map("flash_card")  // Таблица в БД будет flash_card
}

model CardProgress {
  id        Int      @id @default(autoincrement())
  userId    Int
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  cardId    Int
  card      FlashCard @relation(fields: [cardId], references: [id], onDelete: Cascade)
  difficulty Int     @default(0)
  nextReview DateTime
  interval  Int       @default(1)
  createdAt DateTime @default(now())
  
  @@unique([userId, cardId])
  @@map("card_progress")
}

model StudySession {
  id        Int      @id @default(autoincrement())
  userId    Int
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  cardSetId Int
  cardSet   CardSet  @relation(fields: [cardSetId], references: [id], onDelete: Cascade)
  score     Int?
  completed Boolean @default(false)
  createdAt DateTime @default(now())
  
  @@map("study_session")
}

model FavoriteCardSet {
  id        Int      @id @default(autoincrement())
  userId    Int
  cardSetId Int
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  cardSet   CardSet  @relation(fields: [cardSetId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@unique([userId, cardSetId])
  @@map("favorite_card_set")  // Таблица в БД будет favorite_card_set
}

model FavoriteCard {
  id        Int      @id @default(autoincrement())
  userId    Int
  cardId    Int
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  card      FlashCard @relation(fields: [cardId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@unique([userId, cardId])
  @@map("favorite_card")
}