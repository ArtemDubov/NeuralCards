generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "linux-musl-openssl-3.0.x", "debian-openssl-3.0.x"]
}

datasource db {
  provider = "sqlite"
  url = "file:./dev.db"
}

model User {
  id        Int      @id @default(autoincrement())
  email     String   @unique
  password  String
  name      String?
  isPremium Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  cardsets  CardSet[]
  progress  CardProgress[]
  sessions  StudySession[]
  favoriteCardsets FavoriteCardset[]
  favoriteCards     FavoriteCard[]
}

model CardSet {
  id          Int       @id @default(autoincrement())
  title       String
  description String?
  isPublic    Boolean   @default(false)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  authorId    Int
  author      User      @relation(fields: [authorId], references: [id], onDelete: Cascade)
  cards       FlashCard[]
  // УДАЛИТЬ эту строку: favorites   Favorite[]
  tags        Tag[]     @relation("CardSetToTag")
  search_vector Unsupported("tsvector")?
  sessions    StudySession[]
  // ДОБАВИТЬ эту связь:
  favoriteCardsets FavoriteCardset[]
}

model Tag {
  id        Int       @id @default(autoincrement())
  name      String    @unique
  cardsets  CardSet[] @relation("CardSetToTag")
}

model FlashCard {
  id          Int      @id @default(autoincrement())
  front       String
  back        String
  imageUrl    String?
  audioUrl    String?
  backImageUrl String?
  backAudioUrl String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  cardsetId   Int
  cardset     CardSet  @relation(fields: [cardsetId], references: [id], onDelete: Cascade)
  search_vector Unsupported("tsvector")?
  progress    CardProgress[]
  // ДОБАВИТЬ эту связь:
  favoriteCards FavoriteCard[]
}

model CardProgress {
  id        Int      @id @default(autoincrement())
  userId    Int
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  cardId    Int
  card      FlashCard @relation(fields: [cardId], references: [id], onDelete: Cascade)
  difficulty Int     @default(0)
  nextReview DateTime
  interval  Int       @default(1)
  createdAt DateTime @default(now())
  
  @@unique([userId, cardId])
}

model StudySession {
  id        Int      @id @default(autoincrement())
  userId    Int
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  cardsetId Int
  cardset   CardSet  @relation(fields: [cardsetId], references: [id], onDelete: Cascade)
  score     Int?
  completed Boolean @default(false)
  createdAt DateTime @default(now())
}

// ========== МОДЕЛИ ИЗБРАННОГО (ТОЛЬКО ОДИН РАЗ!) ==========

model FavoriteCardset {
  id        Int      @id @default(autoincrement())
  userId    Int
  cardsetId Int
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  cardSet   CardSet  @relation(fields: [cardsetId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@unique([userId, cardsetId])
  @@map("favorite_cardsets")
}

model FavoriteCard {
  id        Int      @id @default(autoincrement())
  userId    Int
  cardId    Int
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  card      FlashCard @relation(fields: [cardId], references: [id], onDelete: Cascade) // ИСПРАВЛЕНО: Card → FlashCard
  createdAt DateTime @default(now())

  @@unique([userId, cardId])
  @@map("favorite_cards")
}