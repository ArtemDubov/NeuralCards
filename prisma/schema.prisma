generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "linux-musl-openssl-3.0.x", "debian-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id        Int      @id @default(autoincrement())
  email     String   @unique
  password  String
  name      String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  cardsets  CardSet[]
  favorites Favorite[]
  progress  CardProgress[]
  sessions  StudySession[]
}

model CardSet {
  id          Int       @id @default(autoincrement())
  title       String
  description String?
  isPublic    Boolean   @default(false)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  authorId    Int
  author      User      @relation(fields: [authorId], references: [id], onDelete: Cascade)
  cards       FlashCard[]
  favorites   Favorite[]
  tags        Tag[]     @relation("CardSetToTag") // Правильная связь many-to-many
  search_vector Unsupported("tsvector")?
  sessions    StudySession[]
}

model Tag {
  id        Int       @id @default(autoincrement())
  name      String    @unique  // ДОБАВЬТЕ @unique!
  cardsets  CardSet[] @relation("CardSetToTag")
}

model FlashCard {
  id          Int      @id @default(autoincrement())
  front       String
  back        String
  imageUrl    String?
  audioUrl    String?
  backImageUrl String?
  backAudioUrl String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  cardsetId   Int
  cardset     CardSet  @relation(fields: [cardsetId], references: [id], onDelete: Cascade)
  search_vector Unsupported("tsvector")?
  progress    CardProgress[]
}

model Favorite {
  id        Int      @id @default(autoincrement())
  userId    Int
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  cardsetId Int?
  cardSet   CardSet? @relation(fields: [cardsetId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
  
  @@unique([userId, cardsetId])
}

model CardProgress {
  id        Int      @id @default(autoincrement())
  userId    Int
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  cardId    Int
  card      FlashCard @relation(fields: [cardId], references: [id], onDelete: Cascade)
  difficulty Int     @default(0) // 0-легко, 1-средне, 2-трудно
  nextReview DateTime // Когда показывать снова
  interval  Int       @default(1) // Интервал в днях
  createdAt DateTime @default(now())
  
  @@unique([userId, cardId])
}

model StudySession {
  id        Int      @id @default(autoincrement())
  userId    Int
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  cardsetId Int
  cardset   CardSet  @relation(fields: [cardsetId], references: [id], onDelete: Cascade)
  score     Int?     // Для викторины
  completed Boolean @default(false)
  createdAt DateTime @default(now())
}